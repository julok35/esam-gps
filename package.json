{
  "name": "esam-gps",
  "private": true,
  "description": "Convertisseur de coordonnées GPS de l'ESAM (site statique, sans build).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "node --test",
    "e2e": "node e2e/parcours.js",
    "lint": "eslint .",
    "format": "prettier --write \"js/**/*.js\" sw.js \"test/**/*.js\" \"e2e/**/*.js\" eslint.config.js",
    "format:check": "prettier --check \"js/**/*.js\" sw.js \"test/**/*.js\" \"e2e/**/*.js\" eslint.config.js",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
